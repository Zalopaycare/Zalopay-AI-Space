# Required — generate a real random secret for production, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret

# Comma-separated company email domains allowed to log in
COMPANY_EMAIL_DOMAINS=zalopay.vn,vng.com.vn

# Comma-separated emails that get Admin Console access on login
ADMIN_EMAILS=

# SMTP — required to actually send login-code / notification emails.
# Without these, the server logs the code to its console instead of emailing it (fine for
# testing, not for real use — never set ALLOW_DEV_LOGIN_CODE=true in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Leave unset (or "false") in production. Only for local testing without SMTP configured —
# it echoes the login code back in the API response instead of only emailing it.
ALLOW_DEV_LOGIN_CODE=false
