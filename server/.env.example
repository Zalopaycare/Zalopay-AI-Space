# Required — generate a real random secret for production, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret

# Comma-separated company email domains allowed to log in
COMPANY_EMAIL_DOMAINS=zalopay.vn,vng.com.vn

# Comma-separated emails that get Admin Console access on login
ADMIN_EMAILS=

# Microsoft Entra ID (Azure AD) SSO — optional. Leave all blank to keep using the
# email-code login only; once all four are set, a "Đăng nhập bằng Microsoft" button
# appears automatically. Get these from IT after they create the App Registration
# (see the request template in server/README.md).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=https://YOUR-DOMAIN/api/auth/sso/callback

# SMTP — required to actually send login-code / notification emails.
# Without these, the server logs the code to its console instead of emailing it (fine for
# testing, not for real use — never set ALLOW_DEV_LOGIN_CODE=true in production).
#
# If IT set this up as an IP-allowlisted relay (e.g. Exchange Online's "from your org's
# mail server" connector) instead of a mailbox login, leave SMTP_USER/SMTP_PASS blank —
# auth is by the server's outbound IP instead, and SMTP_PORT is usually 25.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Leave unset (or "false") in production. Only for local testing without SMTP configured —
# it echoes the login code back in the API response instead of only emailing it.
ALLOW_DEV_LOGIN_CODE=false
